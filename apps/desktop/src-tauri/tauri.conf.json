{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marmotter",
  "version": "0.1.0",
  "identifier": "uk.co.dashkova.marmotter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Marmotter",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "A modern, multi-network IRC client",
    "longDescription": "Marmotter is a multi-network IRC client that presents the full capability of the protocol through a conventional chat interface, with every raw escape hatch still available.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
