# Build output, and the native libraries the Rust build drops in.
build/
app/build/
app/src/main/jniLibs/
.gradle/
local.properties

# Generated by `gradle wrapper`; the jar is a binary and is not committed.
gradlew
gradlew.bat
gradle/wrapper/gradle-wrapper.jar

# Written by tauri-build during the Android cargo build: the list of Tauri
# projects this build depends on, at paths inside the local cargo registry.
# Per-machine by definition, and regenerated whenever cargo runs.
tauri.settings.gradle
app/tauri.build.gradle.kts

# Written into the app's package during the Android cargo build, from templates
# inside the wry and tauri crates. They sit beside the hand-written Kotlin
# because that is the package they have to be in — `MainActivity` extends
# `TauriActivity`, which extends `WryActivity` — but they are generated, carry
# a DO NOT MODIFY banner, and change with the crate versions.
app/src/main/java/uk/co/dashkova/marmotter/WryActivity.kt
app/src/main/java/uk/co/dashkova/marmotter/TauriActivity.kt
app/src/main/java/uk/co/dashkova/marmotter/Ipc.kt
app/src/main/java/uk/co/dashkova/marmotter/Logger.kt
app/src/main/java/uk/co/dashkova/marmotter/PermissionHelper.kt
app/src/main/java/uk/co/dashkova/marmotter/Rust.kt
app/src/main/java/uk/co/dashkova/marmotter/RustWebView.kt
app/src/main/java/uk/co/dashkova/marmotter/RustWebViewClient.kt
app/src/main/java/uk/co/dashkova/marmotter/RustWebChromeClient.kt
app/src/main/java/uk/co/dashkova/marmotter/proguard-wry.pro
